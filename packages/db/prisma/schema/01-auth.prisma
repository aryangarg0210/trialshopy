// ---------------------------------------------------------------------------
// better-auth models — identity & sessions.
//
// better-auth OWNS authentication (email/password, phone OTP, Google, biometric
// passkeys). Domain data lives in CustomerProfile / SellerProfile (02-identity).
//
// NOTE: the exact plugin columns are ultimately reconciled by running
// `npx @better-auth/cli generate` once the phoneNumber/passkey/bearer plugins
// are wired in auth.ts. The fields below match that expected output.
// ---------------------------------------------------------------------------

enum UserRole {
  customer
  seller
  admin
  storeManager
  storeEmployee
}

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?

  // phoneNumber plugin (SMS OTP login)
  phoneNumber         String?  @map("phone_number")
  phoneNumberVerified Boolean  @default(false) @map("phone_number_verified")

  // admin plugin: role + ban handling
  role      UserRole  @default(customer)
  banned    Boolean   @default(false)
  banReason String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions Session[]
  accounts Account[]
  passkeys Passkey[]

  customerProfile CustomerProfile?
  sellerProfile   SellerProfile?

  @@unique([email])
  @@unique([phoneNumber])
  @@map("user")
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  expiresAt DateTime @map("expires_at")
  token     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // admin plugin: set when an admin is impersonating this user's session
  impersonatedBy String? @map("impersonated_by") @db.ObjectId

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.ObjectId
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

// jwt plugin — JWKS keypairs used to sign/verify issued JWTs
model Jwks {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  publicKey  String   @map("public_key")
  privateKey String   @map("private_key")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("jwks")
}

// passkey plugin — biometric / WebAuthn device credentials (DORMANT until the
// passkey plugin is wired in auth.ts; kept here so the biometric follow-up is
// a config change, not a schema migration).
model Passkey {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String?
  publicKey    String   @map("public_key")
  userId       String   @map("user_id") @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String   @map("credential_id")
  counter      Int
  deviceType   String   @map("device_type")
  backedUp     Boolean  @map("backed_up")
  transports   String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("passkey")
}
