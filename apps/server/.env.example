NODE_ENV=development
HOST=0.0.0.0
PORT=3001

BETTER_AUTH_SECRET=change-me-generate-a-strong-secret
BETTER_AUTH_URL=http://localhost:3001

FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001
CORS_URLS=http://localhost:3000

# MongoDB must run as a replica set for Prisma (Atlas is one by default;
# for local dev start mongod with --replSet rs0 and initiate it once).
DATABASE_URL=mongodb://localhost:27017/trialshopy?replicaSet=rs0

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SMTP configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Your App <noreply@example.com>

# Bull Board (Job Queue Dashboard) credentials
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin

# Cloudinary (media storage — signed direct uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret